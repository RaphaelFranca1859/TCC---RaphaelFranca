# Copie para .env (nao versionado) ou defina estas variaveis na hospedagem. Todas sao opcionais.
LLM_PROVIDER=groq            # groq (plano gratuito) ou xai (Grok, pago)
LLM_API_KEY=                 # chave do provedor; em branco, cada usuario informa a propria chave na interface
LLM_MODEL=                   # em branco usa o modelo padrao do provedor (ver backend/app/assistant.py)
MONGO_URI=                   # ex.: mongodb+srv://usuario:senha@cluster.mongodb.net  (sem isso, usa arquivos JSON)
SESSION_TTL=7200
